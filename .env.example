# Copy to .env for the local docker-compose stack: cp .env.example .env
# These values are for a local machine only. Generate your own for anything reachable by others.

# Only applied when the postgres volume is first created. If you already have a volume, use its existing password.
POSTGRES_PASSWORD=local-postgres-password
# Same password, URL encoded.
PGWEB_DATABASE_URL=postgres://postgres:local-postgres-password@postgres:5432/MilvaionDb?sslmode=disable

# Only applied the first time the database is initialized.
MILVAION_ROOT_PASSWORD=local-root-password

# Signing keys. Left empty, the API generates random ones at startup: sessions and api keys then stop working on
# every restart. Generate persistent values with: openssl rand -hex 32
MILVAION_JWT_SIGNING_KEY=
MILVAION_API_KEY_SECRET=

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

SEQ_FIRSTRUN_ADMINPASSWORD=Local-Seq-Password-1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password

# Opt-ins for local work. Keep false on anything shared.
# MILVAION_DEVELOPER_ENDPOINTS_ENABLED exposes database reset, seed and export (super admin only, except database/init).
MILVAION_DEVELOPER_ENDPOINTS_ENABLED=false
MILVAION_API_DOCS_ENABLED=true
