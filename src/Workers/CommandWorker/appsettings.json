{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "System": "Information"
    },
    "Seq": {
      "Enabled": true,
      "Uri": "http://seq:5341"
    }
  },
  "Worker": {
    "WorkerId": "command-worker-01",
    "MaxParallelJobs": 16,
    "ExecutionTimeoutSeconds": 3600,
    "HealthCheck": {
      "Enabled": true,
      "LiveFilePath": "/tmp/live",
      "ReadyFilePath": "/tmp/ready",
      "IntervalSeconds": 30
    },
    "RabbitMQ": {
      "Host": "rabbitmq",
      "Port": 5672,
      "Username": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "QueueType": "Classic",
      "PublisherConfirms": true
    },
    "Redis": {
      "ConnectionString": "redis:6379",
      "Password": "",
      "Database": 0,
      "KeyPrefix": "Milvaion:JobScheduler:"
    },
    "Heartbeat": {
      "Enabled": true,
      "IntervalSeconds": 5,
      "JobHeartbeatIntervalSeconds": 60
    },
    "OfflineResilience": {
      "Enabled": true,
      "LocalStoragePath": "./worker_data",
      "SyncIntervalSeconds": 30,
      "MaxSyncRetries": 3,
      "CleanupIntervalHours": 1,
      "RecordRetentionDays": 1
    }
  },
  "JobConsumers": {
    "CommandExecutionJob": {
      "ConsumerId": "command-consumer",
      "MaxParallelJobs": 8,
      "ExecutionTimeoutSeconds": 3600,
      "MaxRetries": 3,
      "BaseRetryDelaySeconds": 5,
      "LogUserFriendlyLogsViaLogger": true
    }
  },
  "CommandWorker": {
    "AllowAdHocCommands": false,
    "MaxLoggedLines": 1000,
    "MaxResultOutputChars": 8192,
    "InheritEnvironment": true,
    "Commands": {
      "echo": {
        "Description": "Prints a message (sample)",
        "FileName": "/bin/echo",
        "Arguments": [
          "{message}"
        ],
        "Parameters": {
          "message": {
            "Description": "Text to print",
            "Required": true
          }
        }
      },
      "disk-usage": {
        "Description": "Shows disk usage of a mounted path (sample)",
        "FileName": "/bin/df",
        "Arguments": [
          "-h",
          "{path}"
        ],
        "Parameters": {
          "path": {
            "Description": "Path to check",
            "Default": "/",
            "Pattern": "/[A-Za-z0-9_./-]*"
          }
        }
      }
    }
  }
}
