<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>..\Milvaion.Infrastructure\Milvaion.Infrastructure.xml</DocumentationFile>
		<Configurations>Debug;Release;TemplateTest</Configurations>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="BackgroundServices\JobDispatcherService_MemoryTracked.cs" />
	</ItemGroup>

	<ItemGroup>
	  <!-- ConditionExpression is internal but carries the whole condition grammar, so it is worth
	       testing directly rather than only through the engine's private call site. -->
	  <InternalsVisibleTo Include="Milvaion.UnitTests" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="AsyncFixer" Version="2.1.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
		<PackageReference Include="Bogus" Version="35.6.5" />
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="Cronos" Version="0.13.0" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="11.0.0" />
		<PackageReference Include="Milvasoft.Caching.InMemory" Version="11.0.1" />
		<PackageReference Include="Milvasoft.Caching.Redis" Version="11.0.1" />
		<PackageReference Include="Milvasoft.JobScheduling" Version="11.0.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
		<PackageReference Include="Confluent.Kafka" Version="2.14.2" />
		<PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Expressions" Version="5.1.0-dev-02309" />
		<PackageReference Include="Serilog.Sinks.Postgresql.Alternative" Version="4.2.0" />
		<PackageReference Include="StackExchange.Redis" Version="3.2.0" />
		<PackageReference Include="System.DirectoryServices.Protocols" Version="11.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\Milvaion.Application\Milvaion.Application.csproj" />
	</ItemGroup>


</Project>
